<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | Nuclear Tech: New Horizons</title>
  <meta name="description" content="The page you're looking for doesn't exist. Head back home or check the URL.">
  <link rel="icon" type="image/x-icon" href="resources/favicon.ico">

  <!-- Open Graph / Social embed -->
  <meta property="og:site_name" content="Nuclear Tech: New Horizons">
  <meta property="og:type" content="website">
  <meta property="og:title" content="404 - Page Not Found | Nuclear Tech: New Horizons">
  <meta property="og:description" content="The page you're looking for doesn't exist. Head back home or check the URL.">
  <meta property="og:image" content="https://ntnewhorizons.com/resources/favicon.ico">
  <meta property="og:url" content="https://ntnewhorizons.com">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="404 - Page Not Found | Nuclear Tech: New Horizons">
  <meta name="twitter:description" content="The page you're looking for doesn't exist. Head back home or check the URL.">
  <meta name="twitter:image" content="https://ntnewhorizons.com/resources/favicon.ico">

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="styles/shared-styles.css">
  <link rel="stylesheet" href="styles/404-styles.css">
</head>
<body class="bg-grid scanlines">

  <!-- Background orbs -->
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>

  <!-- Floating debris -->
  <div class="particle-field" id="particleField" aria-hidden="true"></div>

  <%- include('partials/header', { currentPage: '404' }) %>

  <!-- ═══ 404 CONTENT ═══ -->
  <main>
    <div class="page-404">

      <!-- Spinning reactor visual -->
      <div class="reactor-wrap" aria-hidden="true">
        <div class="caution-tape"></div>
        <div class="reactor-ring">
          <div class="orbit">
            <div class="electron"></div>
          </div>
        </div>
        <div class="reactor-ring reactor-ring-2">
          <div class="orbit orbit-2">
            <div class="electron"></div>
          </div>
        </div>
        <div class="reactor-ring reactor-ring-3">
          <div class="orbit orbit-3">
            <div class="electron"></div>
          </div>
        </div>
        <div class="reactor-core">
          <span class="reactor-core-symbol">&#x2622;</span>
        </div>
      </div>

      <!-- Error text -->
      <p class="error-label">Machine Fault Detected</p>
      <div class="error-code" aria-label="Error 404">404</div>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-desc">
        This page doesn't exist. It may have been moved, deleted, or the URL has a typo. Check the address or head back home.
      </p>

      <!-- Terminal readout -->
      <div class="terminal-box" role="complementary" aria-label="System diagnostic">
        <div class="terminal-topbar">
          <span class="terminal-dot dot-red"></span>
          <span class="terminal-dot dot-yellow"></span>
          <span class="terminal-dot dot-green"></span>
          <span class="terminal-title">NTNH_DIAGNOSTIC.exe</span>
        </div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Scanning machine network&hellip; <span class="ok">NOMINAL</span></div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Checking pipeline status&hellip; <span class="ok">STABLE</span></div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Resolving URL path&hellip; <span class="err">NOT FOUND</span></div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Cross-ref page registry&hellip; <span class="err">NULL_REF [0x404]</span></div>
        <div class="terminal-line"><span class="warn">&#x26A0; WARNING:</span> Page does not exist. Check the URL.</div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Waiting for next action&hellip; <span class="cursor-blink"></span></div>
      </div>

      <!-- CTA -->
      <div class="error-actions">
        <a href="/" class="btn btn-primary">
          <i class="fas fa-house"></i> Return Home
        </a>
        <a href="/guide" class="btn btn-secondary">
          <i class="fas fa-map"></i> Getting Started
        </a>
        <a href="/download" class="btn btn-secondary">
          <i class="fas fa-download"></i> Downloads
        </a>
        <a href="https://discord.gg/wtNVzeE5QB" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <i class="fab fa-discord"></i> Get Help
        </a>
      </div>

    </div>
  </main>

  <%- include('partials/footer', { scripts: ['scripts/404-script.js'] }) %>
</body>
</html>
