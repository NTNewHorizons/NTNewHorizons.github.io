<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | Nuclear Tech: New Horizons</title>
  <meta name="description" content="The page you're looking for doesn't exist. Head back home or check the URL.">
  <link rel="icon" type="image/x-icon" href="resources/favicon.ico">

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="styles/shared-styles.css">

  <style>
    /* ─── 404 Canvas ─── */
    .page-404 {
      position: relative;
      z-index: 1;
      min-height: calc(100vh - 70px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
      text-align: center;
      overflow: hidden;
    }

    /* ─── Reactor core visual ─── */
    .reactor-wrap {
      position: relative;
      width: 220px;
      height: 220px;
      margin: 0 auto 3rem;
      flex-shrink: 0;
    }

    /* Outer spinning ring */
    .reactor-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px dashed rgba(255, 80, 0, 0.25);
      animation: ringRotate 12s linear infinite;
    }

    .reactor-ring-2 {
      inset: 18px;
      border: 1px solid rgba(255, 106, 0, 0.3);
      animation: ringRotate 8s linear infinite reverse;
      border-style: dashed;
    }

    .reactor-ring-3 {
      inset: 36px;
      border: 2px solid rgba(255, 140, 0, 0.2);
      animation: ringRotate 5s linear infinite;
      border-style: solid;
    }

    /* Tick marks on outer ring */
    .reactor-ring::before,
    .reactor-ring::after {
      content: '';
      position: absolute;
      width: 6px;
      height: 2px;
      background: var(--orange);
      border-radius: 1px;
      top: 50%;
      right: -4px;
      transform: translateY(-50%);
    }

    .reactor-ring::after {
      right: auto;
      left: -4px;
    }

    /* Center core */
    .reactor-core {
      position: absolute;
      inset: 54px;
      border-radius: 50%;
      background: radial-gradient(circle at 40% 35%,
        rgba(255, 200, 50, 0.9) 0%,
        rgba(255, 100, 0, 0.75) 30%,
        rgba(200, 30, 0, 0.6) 60%,
        rgba(80, 0, 0, 0.8) 100%
      );
      box-shadow:
        0 0 20px rgba(255, 100, 0, 0.8),
        0 0 60px rgba(255, 60, 0, 0.4),
        0 0 100px rgba(255, 30, 0, 0.2),
        inset 0 0 20px rgba(0, 0, 0, 0.5);
      animation: corePulse 3s ease-in-out infinite;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .reactor-core-symbol {
      font-size: 2rem;
      filter: drop-shadow(0 0 8px rgba(255, 220, 100, 0.9));
      animation: symbolSpin 20s linear infinite;
    }

    /* Orbiting electron dots */
    .orbit {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      animation: ringRotate 3s linear infinite;
    }

    .orbit-2 { animation-duration: 5s; animation-direction: reverse; }
    .orbit-3 { animation-duration: 4.2s; }

    .electron {
      position: absolute;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--orange);
      box-shadow: 0 0 10px var(--orange), 0 0 20px rgba(255, 106, 0, 0.5);
      top: 0;
      left: 50%;
      transform: translateX(-50%);
    }

    .orbit-2 .electron { background: var(--yellow); box-shadow: 0 0 10px var(--yellow); width: 5px; height: 5px; }
    .orbit-3 .electron { background: var(--red); box-shadow: 0 0 10px var(--red); width: 6px; height: 6px; }

    /* Caution stripes behind reactor */
    .caution-tape {
      position: absolute;
      width: 340px;
      height: 28px;
      background: repeating-linear-gradient(
        -45deg,
        var(--yellow) 0px,
        var(--yellow) 14px,
        #000 14px,
        #000 28px
      );
      opacity: 0.18;
      border-radius: 2px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-8deg);
      pointer-events: none;
    }

    @keyframes ringRotate {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    @keyframes corePulse {
      0%, 100% { box-shadow: 0 0 20px rgba(255,100,0,0.8), 0 0 60px rgba(255,60,0,0.4), 0 0 100px rgba(255,30,0,0.2), inset 0 0 20px rgba(0,0,0,0.5); }
      50%       { box-shadow: 0 0 30px rgba(255,160,0,1),   0 0 80px rgba(255,80,0,0.6), 0 0 130px rgba(255,50,0,0.3), inset 0 0 20px rgba(0,0,0,0.5); }
    }

    @keyframes symbolSpin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    /* ─── Error code ─── */
    .error-code {
      font-family: 'Chakra Petch', sans-serif;
      font-size: clamp(6rem, 18vw, 12rem);
      font-weight: 700;
      line-height: 0.9;
      letter-spacing: -0.04em;
      background: linear-gradient(135deg, var(--red) 0%, var(--orange) 40%, var(--yellow) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 0 40px rgba(255, 80, 0, 0.5));
      margin-bottom: 0.5rem;
      position: relative;
      animation: glitchText 8s infinite;
    }

    /* Subtle glitch effect */
    @keyframes glitchText {
      0%, 94%, 100% { transform: translate(0); filter: drop-shadow(0 0 40px rgba(255,80,0,0.5)); }
      95%  { transform: translate(-3px, 1px); filter: drop-shadow(3px 0 0 rgba(255,0,0,0.8)) drop-shadow(-3px 0 0 rgba(0,200,255,0.4)); }
      96%  { transform: translate(3px, -1px); filter: drop-shadow(-3px 0 0 rgba(255,0,0,0.8)) drop-shadow(3px 0 0 rgba(0,200,255,0.4)); }
      97%  { transform: translate(0); filter: drop-shadow(0 0 40px rgba(255,80,0,0.5)); }
      98%  { transform: translate(2px, 0); filter: drop-shadow(-2px 0 0 rgba(255,200,0,0.6)); }
    }

    .error-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }

    .error-label::before, .error-label::after {
      content: '';
      height: 1px;
      width: 40px;
      background: linear-gradient(90deg, transparent, var(--orange));
    }
    .error-label::after { background: linear-gradient(90deg, var(--orange), transparent); }

    .error-title {
      font-family: 'Chakra Petch', sans-serif;
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 700;
      color: var(--text-bright);
      margin-bottom: 1rem;
    }

    .error-desc {
      font-size: 1rem;
      color: var(--text-mid);
      max-width: 480px;
      line-height: 1.7;
      margin: 0 auto 2.5rem;
    }

    /* ─── Terminal readout ─── */
    .terminal-box {
      background: rgba(5, 1, 0, 0.85);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.5rem;
      max-width: 460px;
      width: 100%;
      margin: 0 auto 2.5rem;
      text-align: left;
      position: relative;
      backdrop-filter: blur(8px);
    }

    .terminal-box::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      border-radius: 10px 10px 0 0;
      background: linear-gradient(90deg, var(--red), var(--orange), var(--yellow));
    }

    .terminal-topbar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--border);
    }

    .terminal-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
    }
    .dot-red    { background: #ff5f56; }
    .dot-yellow { background: #ffbd2e; }
    .dot-green  { background: #27c93f; }

    .terminal-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      color: var(--text-muted);
      letter-spacing: 0.1em;
      margin-left: auto;
    }

    .terminal-line {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      line-height: 1.9;
      color: var(--text-mid);
    }

    .terminal-line .prompt { color: var(--orange); }
    .terminal-line .ok     { color: #4ade80; }
    .terminal-line .err    { color: var(--red); }
    .terminal-line .warn   { color: var(--yellow); }

    .cursor-blink {
      display: inline-block;
      width: 7px;
      height: 0.85em;
      background: var(--orange);
      vertical-align: middle;
      animation: blink 1.1s step-end infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }

    /* ─── Action buttons ─── */
    .error-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* ─── Floating debris particles ─── */
    .particle-field {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .particle {
      position: absolute;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--orange);
      opacity: 0;
      animation: drift linear infinite;
    }

    @keyframes drift {
      0%   { opacity: 0; transform: translateY(100vh) translateX(0) rotate(0deg); }
      10%  { opacity: 0.6; }
      90%  { opacity: 0.3; }
      100% { opacity: 0; transform: translateY(-20vh) translateX(60px) rotate(720deg); }
    }
  </style>
</head>
<body class="bg-grid scanlines">

  <!-- Background orbs -->
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>

  <!-- Floating debris -->
  <div class="particle-field" id="particleField" aria-hidden="true"></div>

  <%- include('partials/header', { currentPage: '404' }) %>

  <!-- ═══ 404 CONTENT ═══ -->
  <main>
    <div class="page-404">

      <!-- Spinning reactor visual -->
      <div class="reactor-wrap" aria-hidden="true">
        <div class="caution-tape"></div>
        <div class="reactor-ring">
          <div class="orbit">
            <div class="electron"></div>
          </div>
        </div>
        <div class="reactor-ring reactor-ring-2">
          <div class="orbit orbit-2">
            <div class="electron"></div>
          </div>
        </div>
        <div class="reactor-ring reactor-ring-3">
          <div class="orbit orbit-3">
            <div class="electron"></div>
          </div>
        </div>
        <div class="reactor-core">
          <span class="reactor-core-symbol">&#x2622;</span>
        </div>
      </div>

      <!-- Error text -->
      <p class="error-label">Machine Fault Detected</p>
      <div class="error-code" aria-label="Error 404">404</div>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-desc">
        This page doesn't exist. It may have been moved, deleted, or the URL has a typo. Check the address or head back home.
      </p>

      <!-- Terminal readout -->
      <div class="terminal-box" role="complementary" aria-label="System diagnostic">
        <div class="terminal-topbar">
          <span class="terminal-dot dot-red"></span>
          <span class="terminal-dot dot-yellow"></span>
          <span class="terminal-dot dot-green"></span>
          <span class="terminal-title">NTNH_DIAGNOSTIC.exe</span>
        </div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Scanning machine network&hellip; <span class="ok">NOMINAL</span></div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Checking pipeline status&hellip; <span class="ok">STABLE</span></div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Resolving URL path&hellip; <span class="err">NOT FOUND</span></div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Cross-ref page registry&hellip; <span class="err">NULL_REF [0x404]</span></div>
        <div class="terminal-line"><span class="warn">&#x26A0; WARNING:</span> Page does not exist. Check the URL.</div>
        <div class="terminal-line"><span class="prompt">&#x25B6;</span> Waiting for next action&hellip; <span class="cursor-blink"></span></div>
      </div>

      <!-- CTA -->
      <div class="error-actions">
        <a href="/" class="btn btn-primary">
          <i class="fas fa-house"></i> Return Home
        </a>
        <a href="/guide" class="btn btn-secondary">
          <i class="fas fa-map"></i> Getting Started
        </a>
        <a href="/download" class="btn btn-secondary">
          <i class="fas fa-download"></i> Downloads
        </a>
        <a href="https://discord.gg/wtNVzeE5QB" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <i class="fab fa-discord"></i> Get Help
        </a>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    (function () {
      // Spawn floating particles
      const field = document.getElementById('particleField');
      const colors = ['var(--orange)', 'var(--red)', 'var(--yellow)', 'rgba(255,80,0,0.6)'];

      for (let i = 0; i < 28; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.left               = Math.random() * 100 + 'vw';
        p.style.width              = (Math.random() * 3 + 1.5) + 'px';
        p.style.height             = p.style.width;
        p.style.background         = colors[Math.floor(Math.random() * colors.length)];
        p.style.animationDuration  = (Math.random() * 14 + 8) + 's';
        p.style.animationDelay     = (Math.random() * -20) + 's';
        field.appendChild(p);
      }
    })();
  </script>
</body>
</html>
