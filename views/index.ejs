  <script>
  (function() {
    var VIDEOS = ['a9n6abjdiKI', 'wMe3Qcc5_Ns'];
    var currentIdx = -1;
    var ytPlayer = null;
    var ytBg = document.getElementById('youtubeBg');
    var busy = false;

    function pickNext() { return currentIdx === 0 ? 1 : 0; }

    function showBg(idx) {
      if (idx === currentIdx || busy) return;
      busy = true;
      currentIdx = idx;
      ytBg.classList.remove('bg-active');

      setTimeout(function() {
        if (ytPlayer && ytPlayer.loadVideoById) {
          ytPlayer.loadVideoById(VIDEOS[idx]);
        }
        ytBg.classList.add('bg-active');
        busy = false;
      }, 2500);
    }

    function nextBg() { showBg(pickNext()); }

    function onYtState(e) {
      if (e.data === YT.PlayerState.ENDED) nextBg();
    }

    function initYt() {
      if (typeof YT === 'undefined' || typeof YT.Player === 'undefined') {
        setTimeout(initYt, 300);
        return;
      }
      ytPlayer = new YT.Player('ytBgPlayer', {
        videoId: VIDEOS[0],
        playerVars: {
          autoplay: 1, mute: 1, controls: 0,
          modestbranding: 1, rel: 0,
          iv_load_policy: 3, disablekb: 1, fs: 0,
          playsinline: 1, cc_load_policy: 0
        },
        events: {
          onReady: function() {
            currentIdx = 0;
            ytBg.classList.add('bg-active');
          },
          onStateChange: onYtState
        }
      });
    }
    initYt();
  })();
  </script>

