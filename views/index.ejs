  <script>
  (function() {
    var VIDEOS = ['blackhole', 'a9n6abjdiKI', 'wMe3Qcc5_Ns'];
    var currentIdx = -1;
    var ytPlayer = null, ytReady = false;
    var bhVideo = document.getElementById('blackholeVideo');
    var bhBg = document.getElementById('blackholeContainer');
    var ytBg = document.getElementById('youtubeBg');
    var busy = false;

    function pickNext() {
      var pool = [];
      for (var i = 0; i < VIDEOS.length; i++) {
        if (i !== currentIdx) pool.push(i);
      }
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function showBg(idx) {
      if (idx === currentIdx || busy) return;
      busy = true;
      var prev = currentIdx;
      currentIdx = idx;

      if (prev !== -1) {
        var prevEl = VIDEOS[prev] === 'blackhole' ? bhBg : ytBg;
        prevEl.classList.remove('bg-active');
        if (VIDEOS[prev] !== 'blackhole' && ytPlayer && ytPlayer.pauseVideo) {
          ytPlayer.pauseVideo();
        }
      }

      setTimeout(function() {
        if (VIDEOS[idx] === 'blackhole') {
          bhVideo.currentTime = 0;
          bhVideo.play();
          bhBg.classList.add('bg-active');
        } else if (ytReady && ytPlayer && ytPlayer.loadVideoById) {
          ytPlayer.loadVideoById(VIDEOS[idx]);
          ytBg.classList.add('bg-active');
        } else {
          currentIdx = 0;
          bhVideo.currentTime = 0;
          bhVideo.play();
          bhBg.classList.add('bg-active');
        }
        busy = false;
      }, 800);
    }

    function nextBg() { showBg(pickNext()); }

    // Crossfade ~2.5s before video ends (not after)
    var bhSeekFired = false;
    bhVideo.addEventListener('timeupdate', function() {
      if (bhSeekFired) return;
      if (bhVideo.duration && bhVideo.duration - bhVideo.currentTime < 2.5) {
        bhSeekFired = true;
        nextBg();
      }
    });
    bhVideo.addEventListener('ended', function() {
      if (!bhSeekFired) nextBg();
      bhSeekFired = false;
    });
    bhVideo.addEventListener('playing', function() {
      bhSeekFired = false;
    });

    function onYtState(e) {
      if (e.data === YT.PlayerState.PLAYING) {
        // Poll current time to crossfade before YT video ends
        var ytCheck = setInterval(function() {
          if (!ytPlayer || !ytPlayer.getDuration || !ytPlayer.getCurrentTime) return;
          var dur = ytPlayer.getDuration();
          var cur = ytPlayer.getCurrentTime();
          if (dur && dur - cur < 2.5) {
            clearInterval(ytCheck);
            nextBg();
          }
        }, 250);
      }
      if (e.data === YT.PlayerState.ENDED) {
        // Safety: if we somehow missed the window
        nextBg();
      }
    }

    function initYt() {
      if (typeof YT === 'undefined' || typeof YT.Player === 'undefined') {
        setTimeout(initYt, 300);
        return;
      }
      ytPlayer = new YT.Player('ytBgPlayer', {
        videoId: 'a9n6abjdiKI',
        playerVars: {
          autoplay: 0, mute: 1, controls: 0,
          modestbranding: 1, rel: 0,
          iv_load_policy: 3, disablekb: 1, fs: 0,
          playsinline: 1, cc_load_policy: 0
        },
        events: {
          onReady: function() { ytReady = true; },
          onStateChange: onYtState
        }
      });
    }
    initYt();

    setTimeout(function() {
      currentIdx = 0;
      bhVideo.currentTime = 0;
      bhVideo.play();
      bhBg.classList.add('bg-active');
    }, 300);
  })();
  </script>

