<!-- ═══ COOKIE BANNER ═══ -->
<div class="cookie-banner" id="cookieBanner" role="dialog" aria-label="Cookie notice">
  <div class="cookie-banner-header">
    <span class="cookie-banner-title">&#x1F36A; Cookies</span>
  </div>
  <p class="cookie-banner-body">
    This website uses cookies to enhance your experience. By clicking "Accept", you consent to our use of cookies. You can learn more about cookies and how we use them in our <a href="/privacy-policy">Privacy Policy</a>.
  </p>
  <div class="cookie-banner-actions">
    <button class="cookie-btn cookie-btn-accept" id="cookieAccept">Accept</button>
    <button class="cookie-btn cookie-btn-decline" id="cookieDecline">Decline</button>
  </div>
</div>

<script>
  (function () {
    const banner  = document.getElementById('cookieBanner');
    if (localStorage.getItem('cookiesAccepted')) { banner.remove(); return; }
    const dismiss = () => {
      banner.classList.add('hiding');
      banner.addEventListener('animationend', () => banner.remove(), { once: true });
    };
    document.getElementById('cookieAccept').addEventListener('click', () => {
      localStorage.setItem('cookiesAccepted', 'true');
      dismiss();
    });
    document.getElementById('cookieDecline').addEventListener('click', () => {
      window.location.href = 'https://en.wikipedia.org/wiki/Cookie';
      dismiss();
    });
  })();
</script>

<script>document.getElementById('currentYear').textContent = new Date().getFullYear();</script>

<% if (typeof scripts !== 'undefined' && scripts.length) { %>
  <% scripts.forEach(function(s) { %>
<script src="<%= s %>"></script>
  <% }); %>
<% } %>

</body>
</html>
