<!-- ═══ NAVIGATION ═══ -->
<%
  const menuLinks = {
    index: [
      { href: '#home', label: 'Home' },
      { href: '#features', label: 'Core Features' },
      { href: '#screenshots', label: 'Screenshots' },
      { href: '#teaser', label: 'Teaser Video' },
      { href: '#progression', label: 'Tech Progression' },
      { href: '#pulse', label: 'Development' },
      { href: '#download', label: 'Download' },
      { href: '#support', label: 'Support' },
      { href: '#community', label: 'Community' },
    ],
    guide: [
      { href: '#community', label: 'Community' },
      { href: '#requirements', label: 'Requirements' },
      { href: '#install', label: 'Install Guide' },
      { href: '#launchers', label: 'Launcher Comparison' },
      { href: '#faq', label: 'FAQ' },
    ],
    about: [
      { href: '#ch1', label: 'I. The Beginning' },
      { href: '#ch2', label: 'II. Generations' },
      { href: '#ch3', label: 'III. Burnout' },
      { href: '#ch4', label: 'IV. Philosophy' },
      { href: '#ch5', label: 'V. Today' },
    ],
  };
  const links = menuLinks[currentPage] || [];
%>
<header>
  <nav class="nav-bar">
    <button class="nav-logo-btn" id="hamburgerToggle" style="flex:1;" aria-label="Open page menu">
      <div class="nav-logo-icon"><img src="resources/favicon.ico" alt="NT:NH Logo" style="width: 24px; height: 24px;"></div>
      <span class="nav-logo-text">NT:NH</span>
    </button>

    <ul class="nav-links">
      <li><a href="/" <%= currentPage === 'index' ? 'style="color:var(--orange);"' : '' %>>Home</a></li>
      <li><a href="/#features">Features</a></li>
      <li><a href="/download" <%= currentPage === 'download' ? 'style="color:var(--orange);"' : '' %>>Downloads</a></li>
      <li><a href="/guide" <%= currentPage === 'guide' ? 'style="color:var(--orange);"' : '' %>>Guide</a></li>
      <li><a href="https://ntnewhorizons.com/blog">Blog</a></li>
      <li><a href="https://status.ntnewhorizons.com">Status</a></li>
      <li><a href="/about" <%= currentPage === 'about' ? 'style="color:var(--orange);"' : '' %>>About</a></li>
    </ul>

    <div class="nav-icons" style="flex:1;justify-content:flex-end;">
      <a href="https://ko-fi.com/ntnewhorizons" target="_blank" rel="noopener noreferrer" class="icon-btn icon-btn-kofi" title="Support on Ko-fi">
        <i class="fas fa-mug-hot"></i>
      </a>
      <a href="https://x.com/ntnewhorizons" target="_blank" rel="noopener noreferrer" class="icon-btn" title="X / Twitter">
        <i class="fab fa-x-twitter"></i>
      </a>
      <a href="https://www.curseforge.com/minecraft/modpacks/ntnewhorizons" target="_blank" rel="noopener noreferrer" class="icon-btn" title="CurseForge">
        <i class="fas fa-fire-flame-curved"></i>
      </a>
      <a href="https://www.youtube.com/@ntnewhorizons" target="_blank" rel="noopener noreferrer" class="icon-btn" title="YouTube">
        <i class="fab fa-youtube"></i>
      </a>
      <a href="https://www.technicpack.net/modpack/nuclear-tech-new-horizons" target="_blank" rel="noopener noreferrer" class="icon-btn" title="Technic Launcher">
        <i class="fas fa-wrench"></i>
      </a>
      <a href="https://discord.gg/wtNVzeE5QB" target="_blank" rel="noopener noreferrer" class="icon-btn" title="Discord">
        <i class="fab fa-discord"></i>
      </a>
      <a href="https://github.com/NTNewHorizons" target="_blank" rel="noopener noreferrer" class="icon-btn" title="GitHub">
        <i class="fab fa-github"></i>
      </a>
    </div>
  </nav>
</header>

<!-- ═══ OST ANNOUNCEMENT ═══ -->
<div class="announcement-bar" id="announcementBar">
  <div class="announcement-content">
    <span class="announcement-icon">&#x1F3B5;</span>
    <span><strong>NTNH OST &mdash; Disc 1 is out!</strong></span>
    <a href="https://bufka2011.bandcamp.com/album/ntnh-ost-disc-1" target="_blank" rel="noopener noreferrer">Bandcamp</a>
    <span class="announcement-sep">&middot;</span>
    <a href="https://soundcloud.com/alexbulka/sets/ntnh-ost-disc-1" target="_blank" rel="noopener noreferrer">SoundCloud</a>
    <span class="announcement-sep">&middot;</span>
    <span class="announcement-coming">YouTube soon</span>
  </div>
  <button class="announcement-close" id="announcementClose" aria-label="Close announcement">&times;</button>
</div>

<div class="hamburger-overlay" id="hamburgerOverlay"></div>
<nav class="hamburger-menu" id="hamburgerMenu" aria-label="Site navigation">
  <div class="hamburger-global">
    <a href="/" class="hamburger-global-link">Home</a>
    <a href="/download" class="hamburger-global-link">Downloads</a>
    <a href="/guide" class="hamburger-global-link">Guide</a>
    <a href="https://ntnewhorizons.com/blog" class="hamburger-global-link">Blog</a>
    <a href="https://status.ntnewhorizons.com" class="hamburger-global-link">Status</a>
    <a href="/about" class="hamburger-global-link">About</a>
  </div>
  <% if (links.length) { %>
    <div class="hamburger-divider"></div>
    <div class="hamburger-sections">
      <span class="hamburger-sections-label">On this page</span>
      <% links.forEach(function(link) { %>
        <a href="<%= link.href %>" class="hamburger-section-link"><%= link.label %></a>
      <% }); %>
    </div>
  <% } %>
</nav>

<script src="scripts/header-script.js"></script>
