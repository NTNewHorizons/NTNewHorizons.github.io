<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Downloads - Nuclear Tech: New Horizons</title>
  <meta name="description" content="Download Nuclear Tech: New Horizons - all official releases, changelogs, and assets.">
  <link rel="icon" type="image/x-icon" href="resources/favicon.ico">

  <!-- Open Graph / Social embed -->
  <meta property="og:site_name" content="Nuclear Tech: New Horizons">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Downloads - Nuclear Tech: New Horizons">
  <meta property="og:description" content="Download Nuclear Tech: New Horizons - all official releases, changelogs, and assets.">
  <meta property="og:image" content="https://ntnewhorizons.com/resources/favicon.ico">
  <meta property="og:url" content="https://ntnewhorizons.com/download">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Downloads - Nuclear Tech: New Horizons">
  <meta name="twitter:description" content="Download Nuclear Tech: New Horizons - all official releases, changelogs, and assets.">
  <meta name="twitter:image" content="https://ntnewhorizons.com/resources/favicon.ico">

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <!-- Marked.js -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <!-- Styles -->
  <link rel="stylesheet" href="styles/shared-styles.css">
  <link rel="stylesheet" href="styles/download-styles.css">
</head>
<body class="bg-grid scanlines">

  <!-- Black hole background -->
  <div class="blackhole-bg bg-active" aria-hidden="true">
    <video muted playsinline preload="auto" loop autoplay>
      <source src="/resources/blackhole.webm" type="video/webm">
      <source src="/resources/blackhole_web.mp4" type="video/mp4">
    </video>
  </div>

  <!-- Background orbs -->
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>

  <%- include('partials/header', { currentPage: 'download' }) %>

  <!-- ═══ HERO ═══ -->
  <main>
    <div class="dl-hero">
      <p class="section-label" style="justify-content:center;margin-bottom:0.75rem;">All Releases</p>
      <h1 class="dl-hero-title">Downloads</h1>
      <p class="dl-hero-sub">
        Official releases pulled live from GitHub. Always up to date. Pick a version and get started.
      </p>
    </div>

    <!-- ═══ PLATFORMS ═══ -->
    <div class="releases-wrap" style="padding-bottom:1rem;">
      <div class="dl-platforms">
        <div class="card dl-card">
          <div class="dl-card-header"><i class="fas fa-server"></i> Server Download</div>
          <p class="dl-card-body">Server files are available on our <a href="https://github.com/NTNewHorizons/NTNewHorizons.github.io/releases" target="_blank" rel="noopener noreferrer">GitHub Releases</a> page. Grab the <code>-server</code> asset from any release.</p>
        </div>

        <div class="card dl-card">
          <div class="dl-card-header"><i class="fab fa-curseforge"></i> CurseForge</div>
          <p class="dl-card-body">Available on <a href="https://www.curseforge.com/minecraft/modpacks/ntnewhorizons" target="_blank" rel="noopener noreferrer">CurseForge</a> — search "NT New Horizons" in the CurseForge app or install manually.</p>
        </div>

        <div class="card dl-card">
          <div class="dl-card-header"><i class="fas fa-cubes"></i> Technic</div>
          <p class="dl-card-body">Play on <a href="https://www.technicpack.net/modpack/ntnewhorizons" target="_blank" rel="noopener noreferrer">Technic</a> — search "NT New Horizons" in the Technic Launcher.</p>
        </div>

        <div class="card dl-card">
          <div class="dl-card-header"><i class="fab fa-modrinth"></i> Modrinth</div>
          <p class="dl-card-body">Not on Modrinth <em>yet</em> — planning to be there soon&trade;</p>
        </div>
      </div>
    </div>

    <!-- ═══ RELEASES ═══ -->
    <div class="releases-wrap">

      <!-- Loading state -->
      <div id="loadingState" class="state-center">
        <i class="fas fa-circle-notch spin" style="color:var(--orange)"></i>
        <p>Fetching releases from GitHub&hellip;</p>
      </div>

      <!-- Error state (hidden by default) -->
      <div id="errorState" class="state-center" style="display:none;">
        <i class="fas fa-triangle-exclamation" style="color:var(--crimson)"></i>
        <p>Failed to load releases.<br>Check the console for details and try again later.</p>
      </div>

      <!-- Releases inserted here -->
      <div id="releasesContainer"></div>
    </div>
  </main>

  <%- include('partials/footer', { scripts: ['scripts/download-script.js', 'scripts/webmcp.js'] }) %>

</body>
</html>
